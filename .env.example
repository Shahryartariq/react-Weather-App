OPENWEATHER_API_KEY=
# Optional: show built-in sample data instead of calling OpenWeather (ignored in Vercel production).
# WEATHER_SAMPLE_DATA=1
# Optional: the public address. On Vercel it defaults to https://getskycast.vercel.app.
# SITE_URL=https://example.com
# Optional: the code Google Search Console gives you for the HTML tag method.
# GOOGLE_SITE_VERIFICATION=
# Optional: a Google Analytics 4 measurement ID. Nothing from Google loads without it.
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
