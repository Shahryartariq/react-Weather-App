OPENWEATHER_API_KEY=
# Optional: show built-in sample data instead of calling OpenWeather (ignored in Vercel production).
# WEATHER_SAMPLE_DATA=1
# Optional: the public address, if it's not https://getskycast.vercel.app.
# SITE_URL=https://example.com
# Optional: the code Google Search Console gives you for the HTML tag method.
# GOOGLE_SITE_VERIFICATION=
# Optional: set to 1 once Web Analytics is switched on in the Vercel dashboard.
# ENABLE_WEB_ANALYTICS=1
